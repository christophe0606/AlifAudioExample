  </TR>
<TR>
 
<TD></TD>
<TD PORT="r"><FONT POINT-SIZE="12.0" COLOR="black">r</FONT></TD>
</TR>

</TABLE>>];

dup0 [shape=point,label="dup0"]

dup1 [shape=point,label="dup1"]

